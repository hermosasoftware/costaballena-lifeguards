			flex-direction: column;
			gap: 5px;
			padding: 0 8px;
			border-right: 1px solid rgba(255, 255, 255, 0.2);
		}

		.hero-stat:last-of-type {
			border-right: none;
		}

		/* Dividers hidden on mobile (border-right used instead) */
		.hero-stat-divider {
			display: none;
		}

		.hero-stat-num {
			font-size: clamp(22px, 6vw, 34px);
			font-weight: 900;
			color: white;
			line-height: 1;
			letter-spacing: -0.02em;
		}

		.hero-stat-label {
			font-size: 10px;
			font-weight: 600;
			color: rgba(255, 255, 255, 0.68);
			line-height: 1.35;
			word-break: break-word;
		}

		/* Tablet+: flex row with traditional dividers */
		@media (min-width: 640px) {
			.hero-stats {
				display: flex;
				align-items: center;
				gap: 0;
				margin-top: 34px;
				padding-top: 26px;
			}

			.hero-stat {
				padding: 0;
				padding-right: 28px;
				margin-right: 28px;
				border-right: none;
			}

			.hero-stat-divider {
				display: block;
				width: 1px;
				height: 38px;
				background: rgba(255, 255, 255, 0.22);
				flex-shrink: 0;
				margin-right: 28px;
			}

			.hero-stat-label {
				font-size: 12px;
				letter-spacing: 0.03em;
			}
		}

		/* ── Hero background — Ken Burns slow zoom ───────────── */
		@keyframes kenBurns {
			0%   { transform: scale(1.03); }
			50%  { transform: scale(1.10); }
			100% { transform: scale(1.03); }
		}

		.hero-bg {
			animation: kenBurns 28s ease-in-out infinite;
		}

		@media (prefers-reduced-motion: reduce) {
			.hero-bg { animation: none; }
		}

		/* ── Wave ────────────────────────────────────────────── */
		.hero-wave {
			position: absolute;
			bottom: -1px;
			left: 0;
			right: 0;
			z-index: 3;
			height: 130px;
			overflow: hidden;
			pointer-events: none;
		}

		.waves-svg {
			position: absolute;
			bottom: 0;
			left: 0;
			width: 100%;
			height: 100%;
			min-height: 60px;
		}

		/* GPU hints — each layer on its own compositor */
		.waves-parallax use {
			transform: translateZ(0);
			will-change: transform;
			backface-visibility: hidden;
			animation: gentleWave 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
		}

		/* Different speeds per layer → natural parallax */
		.waves-parallax use:nth-child(1) { animation-duration:  7s; animation-delay: -2s; }
		.waves-parallax use:nth-child(2) { animation-duration: 10s; animation-delay: -3s; }
		.waves-parallax use:nth-child(3) { animation-duration: 13s; animation-delay: -4s; }
		.waves-parallax use:nth-child(4) { animation-duration: 20s; animation-delay: -5s; }

		@keyframes gentleWave {
			0%   { transform: translate3d(-90px, 0, 0); }
			100% { transform: translate3d( 85px, 0, 0); }
		}

		/* Respect prefers-reduced-motion */
		@media (prefers-reduced-motion: reduce) {
			.waves-parallax use { animation: none; }
		}

		@media (max-width: 640px) {
			.hero-stats {
				gap: 0;
			}

			.hero-stat {
				padding-right: 18px;
				margin-right: 18px;
			}

