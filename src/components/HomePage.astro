---
import { Image } from 'astro:assets';
import { copy, type Lang, formatPlayaHermosaRaisedOf } from '../i18n/copy';
import { getRoutes } from '../i18n/routes';
import TiersSection from './TiersSection.astro';

import heroBg from '../assets/lifeguard-testing-day-28.webp';
import seaBg from '../assets/sea.webp';
import supportImg from '../assets/domi-tower-inauguration-2.webp';
import heroPhoto from '../assets/domi-tower-inauguration-50.webp';
import progVolunteer from '../assets/Volunteer.jpg';
import progJunior from '../assets/JuniorLifguard.png';
import progCommunity from '../assets/CommunityOutreach.png';
import {
	impact2026,
	impactHeroAssists,
	impactHeroRescues,
	impactPreventionBarWidth,
	type ImpactBeachId,
	type ImpactMetricId,
} from '../data/impact2026';

interface Props {
	lang: Lang;
}

const { lang } = Astro.props;
const c = copy[lang];
const routes = getRoutes(lang);
const donateHref = routes.donate;
const contactHref = routes.contact;

function parseUsdEnv(value: string | undefined, fallback: number): number {
	if (value === undefined || value === '') return fallback;
	const n = Number(value);
	return Number.isFinite(n) && n >= 0 ? n : fallback;
}

/** Mounts for Playa Hermosa (build-time). See `.env.example`. */
const playaHermosaRaised = parseUsdEnv(import.meta.env.PUBLIC_PLAYA_HERMOSA_RAISED, 60000);
const playaHermosaGoal = parseUsdEnv(import.meta.env.PUBLIC_PLAYA_HERMOSA_GOAL, 100000);
const playaHermosaPct =
	playaHermosaGoal > 0
		? Math.min(100, Math.max(0, Math.round((playaHermosaRaised / playaHermosaGoal) * 100)))
		: 0;

function formatReopenScaleUsd(usd: number): string {
	if (usd === 0) return '$0';
	if (usd >= 1_000_000) {
		const m = usd / 1_000_000;
		return Number.isInteger(m) ? `$${m}M` : `$${m.toFixed(1)}M`;
	}
	if (usd >= 1000) {
		const k = usd / 1000;
		return Number.isInteger(k) ? `$${k}k` : `$${k.toFixed(1)}k`;
	}
	return `$${usd}`;
}

const reopenScaleTicks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(playaHermosaGoal * f));
const raisedOfLabel = formatPlayaHermosaRaisedOf(lang, playaHermosaGoal);
const reopenAriaLabel =
	lang === 'es'
		? `Progreso de la campaña: ${playaHermosaPct}%`
		: `Campaign progress: ${playaHermosaPct}%`;

const impactMetricLabel = (id: ImpactMetricId) => c.home.impactMetricLabels[id];
const impactBeachTabLabel = (id: ImpactBeachId) =>
	id === 'dominical' ? c.home.impactTabDominical : c.home.impactTabHermosa;
const impactBeachPeriod = (id: ImpactBeachId) =>
	id === 'dominical' ? c.home.impactPeriodDominical : c.home.impactPeriodHermosa;
const impactMetricNote = (key: 'drowningDominical' | 'deathsHermosa') =>
	c.home.impactMetricNotes[key];

const heroPreventionsDisplay = `${impact2026.totalPreventions.toLocaleString()}+`;
const heroRescuesDisplay = impactHeroRescues().toLocaleString();
const heroAssistsDisplay = impactHeroAssists().toLocaleString();
---

<main class="page-padding">
	<section class="hero">
		<Image
			class="hero-bg"
			src={heroPhoto}
			alt=""
			priority
			decoding="async"
			width={heroPhoto.width}
			height={heroPhoto.height}
			sizes="100vw"
		/>
		<div class="hero-overlay" aria-hidden="true" />

		<div class="container hero-inner">
			<div class="hero-copy">
				<div class="kicker">{c.siteName}</div>
				<h1>{c.home.heroTitle}</h1>
				<p class="hero-sub">{c.home.heroSubtitle}</p>

				<div class="hero-actions">
					<a class="btn btn-accent hero-btn-sponsor" href={donateHref}>
						{c.home.sponsor}
					</a>
					<a class="btn btn-outline hero-btn-volunteer" href={contactHref}>
						{c.home.volunteer}
					</a>
				</div>

				<!-- ── Stats strip ───────────────────────── -->
				<div class="hero-stats" role="list">
				<div class="hero-stat" role="listitem">
					<span class="hero-stat-num">{heroPreventionsDisplay}</span>
					<span class="hero-stat-label">{c.home.heroStatPreventions}</span>
				</div>
				<div class="hero-stat-divider" aria-hidden="true" />
				<div class="hero-stat" role="listitem">
					<span class="hero-stat-num">{heroRescuesDisplay}</span>
					<span class="hero-stat-label">{c.home.heroStatRescues}</span>
				</div>
				<div class="hero-stat-divider" aria-hidden="true" />
				<div class="hero-stat" role="listitem">
					<span class="hero-stat-num">{heroAssistsDisplay}</span>
					<span class="hero-stat-label">{c.home.heroStatAssists}</span>
				</div>
				</div>
			</div>
		</div>

		<!-- ── Wave transition (4 parallax layers via <use>) ─── -->
		<!--
			Single <path> in <defs> reused 4× with different opacity and speed for organic parallax.
			GPU-composited: translateZ(0) + will-change + backface-visibility.
		-->
		<div class="hero-wave" aria-hidden="true">
			<svg
				class="waves-svg"
				xmlns="http://www.w3.org/2000/svg"
				xmlns:xlink="http://www.w3.org/1999/xlink"
				viewBox="0 21 150 30"
				preserveAspectRatio="none"
				shape-rendering="geometricPrecision"
			>
				<defs>
					<path
						id="gentle-wave"
						d="M-160 44c30 0 58-18 88-18s58 18 88 18 58-18 88-18 58 18 88 18v48h-352z"
					/>
				</defs>
				<g class="waves-parallax">
					<use xlink:href="#gentle-wave" x="48" y="0" fill="#00205b" fill-opacity="0.20"/>
					<use xlink:href="#gentle-wave" x="48" y="3" fill="#00205b" fill-opacity="0.42"/>
					<use xlink:href="#gentle-wave" x="48" y="5" fill="#00205b" fill-opacity="0.68"/>
					<use xlink:href="#gentle-wave" x="48" y="7" fill="#00205b"/>
				</g>
			</svg>
		</div>
	</section>

	<!-- ─── COMBINED: Reality → Support → Where ─────────────────── -->
	<!--
		Flows from the hero wave. One dark-blue block that:
		1. States the urgency (Reality)
		2. Shows what support makes possible (glass cards)
	-->
	<section class="combined-section bg-base">
		<div class="container">

			<!-- ── PART 1: The Reality ───────────────────────────── -->
			<div class="cs-reality">
				<div class="cs-reality-kicker reveal">{c.home.realityTitle}</div>
				<p class="reality-heading reveal reveal-d1">{c.home.realityHeading}</p>
				<p class="reality-sub reveal reveal-d2">
					{c.home.realitySub}<em class="reality-accent">{c.home.realityAccent}</em>
				</p>
			</div>

			<div class="combined-sep" aria-hidden="true"></div>

			<!-- ── PART 2: What your support makes possible ─────── -->
			<div class="cs-support">
				<h2 class="h2 reveal" style="color: white; margin-bottom: 8px;">{c.home.supportTitle}</h2>
				<p class="muted reveal reveal-d1" style="max-width: 54ch;">{c.home.supportSubtitle}</p>
				<div class="support-cards-grid" style="margin-top: 32px;">
					<div class="support-card reveal reveal-d1">
						<div class="support-card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
							</svg>
						</div>
						<h3 class="support-card-title">{c.home.supportCards[0].title}</h3>
						<p class="support-card-desc">{c.home.supportCards[0].desc}</p>
					</div>
					<div class="support-card reveal reveal-d2">
						<div class="support-card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<circle cx="12" cy="12" r="10"/>
								<circle cx="12" cy="12" r="4"/>
								<line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
								<line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
								<line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
								<line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
							</svg>
						</div>
						<h3 class="support-card-title">{c.home.supportCards[1].title}</h3>
						<p class="support-card-desc">{c.home.supportCards[1].desc}</p>
					</div>
					<div class="support-card reveal reveal-d3">
						<div class="support-card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
								<circle cx="9" cy="7" r="4"/>
								<path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
								<path d="M16 3.13a4 4 0 0 1 0 7.75"/>
							</svg>
						</div>
						<h3 class="support-card-title">{c.home.supportCards[2].title}</h3>
						<p class="support-card-desc">{c.home.supportCards[2].desc}</p>
					</div>
					<div class="support-card reveal reveal-d4">
						<div class="support-card-icon" aria-hidden="true">
							<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
								<path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
								<path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
							</svg>
						</div>
						<h3 class="support-card-title">{c.home.supportCards[3].title}</h3>
						<p class="support-card-desc">{c.home.supportCards[3].desc}</p>
					</div>
				</div>
			</div>

	
		</div>
	</section>

	<!-- ─── WHERE YOUR MONEY GOES ────────────────────────────────── -->
	<!--
		Transparency section — light background for contrast after dark hero + combined blocks.
	-->
	<section class="where-section">
		<div class="container">
			<div class="two-col cs-where-grid">

				<!-- ── Text column ────────────────────────────── -->
				<div class="reveal-left">
					<div class="kicker">{c.home.transparencyKicker}</div>
					<h2 class="where-heading">
						{lang === 'es'
							? <><span>Así se usa</span> tu donación</>
							: <><span>Where your</span> money goes</>}
					</h2>
					<p class="where-intro">{c.home.whereIntro}</p>
					<ol class="where-num-list">
						{c.home.whereBullets.map((b, i) => (
							<li>
								<span class="where-num">{i + 1}</span>
								<span class="where-item-text">{b}</span>
							</li>
						))}
					</ol>
					<div class="where-trust">
						<!-- Shield icon -->
						<svg class="where-trust-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
						</svg>
						<p class="where-trust-text">{c.home.whereTrustText}</p>
					</div>
					<div style="margin-top: 28px;">
						<a class="btn btn-accent" href={donateHref}>{c.home.whereBtn}</a>
					</div>
				</div>

				<!-- ── Image column ───────────────────────────── -->
				<div class="where-img-wrap reveal-right">
					<Image
						class="where-img"
						src={supportImg}
						alt=""
						loading="lazy"
						decoding="async"
						width={supportImg.width}
						height={supportImg.height}
						sizes="(min-width: 960px) 46vw, 100vw"
					/>
					<!-- Floating badge -->
					<div class="where-badge">
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
							<polyline points="20 6 9 17 4 12"/>
						</svg>
						<div>
							<strong>{c.home.whereBadgeTitle}</strong>
							<span>{c.home.whereBadgeSub}</span>
						</div>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- ─── PROGRAMS — accordion hover ──────────────────────────── -->
	<!--
		Dark blue to chain visually with Impact. Numbered list left, sticky image right on hover.
	-->
	<section class="prog-section">
		<div class="container">

			<!-- Header -->
			<div class="prog-header reveal">
				<div class="prog-header-text">
					<div class="kicker">{c.home.programsTitle}</div>
					<h2 class="prog-title">{c.home.programsHeading}</h2>
				</div>
				<p class="prog-header-sub">{c.home.programsHeaderSub}</p>
			</div>

			<div class="prog-layout">

				<!-- ── Accordion list ─────────────────────────── -->
				<div class="prog-list" id="prog-list">

					{c.home.programs.map((prog, i) => (
						<div
							class={`prog-item${i === 0 ? ' is-active' : ''}`}
							data-index={i}
							role="button"
							tabindex="0"
							aria-label={prog.ariaLabel}
						>
							<div class="prog-divider"></div>
							<div class="prog-item-body">
								<div class="prog-meta">
									<span class="prog-num">{String(i + 1).padStart(2, '0')}</span>
								</div>
								<div class="prog-content">
									<h3 class="prog-name">
										{prog.name}
										<span class="prog-arrow" aria-hidden="true">→</span>
									</h3>
									<div class="prog-desc">
										<p>{prog.desc}</p>
									</div>
								</div>
							</div>
						</div>
					))}

					<!-- Bottom line -->
					<div class="prog-divider"></div>

					<!-- CTA -->
					<div class="prog-cta">
						<a class="btn btn-outline" href={contactHref}>{c.home.progCta}</a>
						<p class="prog-cta-note">{c.home.progCtaNote}</p>
					</div>
				</div>

				<!-- ── Image preview (sticky) ─────────────────── -->
				<div class="prog-preview" aria-hidden="true">
					<div class="prog-img-stack">
						<Image
							class="prog-img is-active"
							data-index="0"
							src={progVolunteer}
							alt={c.home.programs[0].altText}
							loading="lazy"
							decoding="async"
							width={progVolunteer.width}
							height={progVolunteer.height}
							sizes="(min-width: 860px) 42vw, 100vw"
						/>
						<Image
							class="prog-img"
							data-index="1"
							src={progJunior}
							alt={c.home.programs[1].altText}
							loading="lazy"
							decoding="async"
							width={progJunior.width}
							height={progJunior.height}
							sizes="(min-width: 860px) 42vw, 100vw"
						/>
						<Image
							class="prog-img"
							data-index="2"
							src={progCommunity}
							alt={c.home.programs[2].altText}
							loading="lazy"
							decoding="async"
							width={progCommunity.width}
							height={progCommunity.height}
							sizes="(min-width: 860px) 42vw, 100vw"
						/>
					</div>
				</div>

			</div>
		</div>
	</section>

	<!-- ─── OUR IMPACT (2026) ───────────────────────────────────── -->
	<section class="impact-section bg-base" id="impact-section">
		<div class="container">

			<header class="impact-header reveal">
				<div class="kicker">{c.home.impactKicker}</div>
				<h2 class="h2 impact-title">{c.home.impactTitle}</h2>
				<p class="impact-subtitle">{c.home.impactSubtitle}</p>
				<p class="impact-period">{c.home.impactPeriod}</p>
			</header>

			<div class="impact-body reveal">
				<aside class="impact-story">
					<p class="impact-update-kicker">{c.home.impactUpdateKicker}</p>
					<h3 class="impact-thanks-title">{c.home.impactThanksTitle}</h3>
					{c.home.impactThanksParagraphs.map((paragraph) => (
						<p class="impact-thanks-p">{paragraph}</p>
					))}
					<ul class="impact-funded-list">
						<li>
							<span class="impact-funded-dot" aria-hidden="true"></span>
							{c.home.impactFundedDominical}
						</li>
						<li>
							<span class="impact-funded-dot" aria-hidden="true"></span>
							{c.home.impactFundedHermosa}
						</li>
					</ul>
				</aside>

				<div class="impact-dashboard">
					<p class="impact-tabs-hint" id="impact-tabs-label">{c.home.impactTabsHint}</p>
					<div
						class="impact-segment"
						role="tablist"
						aria-labelledby="impact-tabs-label"
					>
						{impact2026.beaches.map((beach, i) => (
							<button
								type="button"
								class={`impact-segment-btn${i === 0 ? ' is-active' : ''}`}
								role="tab"
								id={`impact-tab-${beach.id}`}
								aria-selected={i === 0 ? 'true' : 'false'}
								aria-controls={`impact-panel-${beach.id}`}
								data-beach={beach.id}
							>
								{impactBeachTabLabel(beach.id)}
							</button>
						))}
					</div>

					{impact2026.beaches.map((beach, i) => (
						<div
							class={`impact-panel${i === 0 ? ' is-active' : ''}`}
							id={`impact-panel-${beach.id}`}
							role="tabpanel"
							aria-labelledby={`impact-tab-${beach.id}`}
							data-panel={beach.id}
							hidden={i !== 0}
						>
							<p class="impact-panel-period">{impactBeachPeriod(beach.id)}</p>

							<div class="impact-prevention">
								<div class="impact-prev-left">
									<div class="impact-metric-icon impact-metric-icon--hero" aria-hidden="true">
										<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
											<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
											<polyline points="9 12 11 14 15 10"/>
										</svg>
									</div>
									<div
										class="impact-big-num"
										data-count={beach.preventions}
										data-impact-counter
									>
										0
									</div>
									<div class="impact-big-label">{c.home.statPreventions}</div>
									<p class="impact-prev-note">{c.home.prevNote}</p>
								</div>
								<div class="impact-prev-bars">
									<h4 class="impact-bars-title">{c.home.impactCompareTitle}</h4>
									{impact2026.beaches.map((barBeach) => (
										<div class="impact-bar-group">
											<div class="impact-bar-header">
												<span>{impactBeachTabLabel(barBeach.id)}</span>
												<strong>{barBeach.preventions.toLocaleString()}</strong>
											</div>
											<div class="impact-bar-track">
												<div
													class="impact-bar-fill"
													style={`--bar-w: ${impactPreventionBarWidth(barBeach.preventions)};`}
												></div>
											</div>
										</div>
									))}
									<p class="impact-compare-total">
										<span>{c.home.statPreventions}</span>
										<strong>{impact2026.totalPreventions.toLocaleString()}</strong>
									</p>
								</div>
							</div>

							<div class="impact-metrics">
								{beach.metrics.map((metric) => (
									<article
										class={`impact-metric${metric.id === 'deaths' || metric.id === 'drowning' ? ' impact-metric--alert' : ''}`}
									>
										<div class="impact-metric-icon" aria-hidden="true">
											{metric.id === 'medical' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<path d="M12 22C6.5 22 2 17.5 2 12S6.5 2 12 2s10 4.5 10 10-4.5 10-10 10z"/>
													<path d="M12 8v8M8 12h8"/>
												</svg>
											)}
											{metric.id === 'stingray' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
													<circle cx="12" cy="12" r="3"/>
												</svg>
											)}
											{metric.id === 'drowning' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<path d="M2 20c2-4 6-6 10-6s8 2 10 6"/>
													<path d="M12 14V8M9 11l3-3 3 3"/>
												</svg>
											)}
											{metric.id === 'prehospital' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
												</svg>
											)}
											{metric.id === 'rescues' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="4"/>
													<line x1="4.93" y1="4.93" x2="7.76" y2="7.76"/>
													<line x1="16.24" y1="16.24" x2="19.07" y2="19.07"/>
													<line x1="16.24" y1="7.76" x2="19.07" y2="4.93"/>
													<line x1="4.93" y1="19.07" x2="7.76" y2="16.24"/>
												</svg>
											)}
											{metric.id === 'deaths' && (
												<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
													<path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/>
													<line x1="12" y1="9" x2="12" y2="13"/>
													<line x1="12" y1="17" x2="12.01" y2="17"/>
												</svg>
											)}
										</div>
										<div
											class="impact-metric-num"
											data-count={metric.value}
											data-impact-counter
										>
											0
										</div>
										<div class="impact-metric-label">
											{impactMetricLabel(metric.id)}
										</div>
										{metric.noteKey && (
											<p class="impact-metric-note">
												{impactMetricNote(metric.noteKey)}
											</p>
										)}
									</article>
								))}
							</div>
						</div>
					))}
				</div>
			</div>

		</div>
	</section>


	<!-- ─── HELP US REOPEN PLAYA HERMOSA ────────────────────────── -->
