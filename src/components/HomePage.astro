</main>

<script>
	// ── Reopen: animated amount counter + progress bar ────────
	(function () {
		const section = document.getElementById('reopen-section');
		if (!section) return;
		let done = false;

		function parseCampaignNum(value: string | undefined, fallback: number) {
			const n = Number(value);
			return Number.isFinite(n) ? n : fallback;
		}

		const targetRaised = parseCampaignNum(section.dataset.reopenRaised, 60000);
		const targetPct = parseCampaignNum(section.dataset.reopenPct, 60);

		function easeOut(t: number) { return 1 - Math.pow(1 - t, 3); }

		function animateAmount(target: number, pctGoal: number, duration: number) {
			const amountEl = document.getElementById('reopen-amount');
			const pctEl    = document.getElementById('reopen-pct');
			const barEl    = document.getElementById('reopen-bar');
			if (!amountEl || !pctEl || !barEl) return;

			const start = performance.now();
			const finalAmount = '$' + target.toLocaleString('en-US');
			const finalPct = pctGoal + '%';

			const tick = (now: number) => {
				const p = Math.min((now - start) / duration, 1);
				const e = easeOut(p);
				amountEl.textContent = '$' + Math.floor(e * target).toLocaleString('en-US');
				pctEl.textContent = Math.floor(e * pctGoal) + '%';
				if (p < 1) requestAnimationFrame(tick);
				else {
					amountEl.textContent = finalAmount;
					pctEl.textContent = finalPct;
				}
			};
			requestAnimationFrame(tick);

			// Bar fill (CSS transition — add class after small delay)
			setTimeout(() => barEl.classList.add('bar-animated'), 150);
		}

		const obs = new IntersectionObserver(
			(entries) => {
				if (entries[0].isIntersecting && !done) {
					done = true;
					animateAmount(targetRaised, targetPct, 1800);
					obs.disconnect();
				}
			},
			{ threshold: 0.3 }
		);
		obs.observe(section);
	})();

	// ── Impact: beach tabs, counters, comparison bars ───────────
	(function () {
		const section = document.getElementById('impact-section');
		if (!section) return;

		const tabs = section.querySelectorAll<HTMLButtonElement>('.impact-segment-btn');
		const panels = section.querySelectorAll<HTMLElement>('.impact-panel');
		let sectionReady = false;
		const counterRaf = new WeakMap<HTMLElement, number>();

		function easeOut(t: number) {
			return 1 - Math.pow(1 - t, 3);
		}

		function parseCounterValue(text: string) {
			const n = parseInt(text.replace(/[^\d]/g, ''), 10);
			return Number.isFinite(n) ? n : 0;
		}

		function animateCounter(el: HTMLElement, target: number, duration = 1400) {
			const prevRaf = counterRaf.get(el);
			if (prevRaf !== undefined) cancelAnimationFrame(prevRaf);

			const from = parseCounterValue(el.textContent ?? '0');
			const start = performance.now();

			const tick = (now: number) => {
				const progress = Math.min((now - start) / duration, 1);
				const value = Math.round(from + (target - from) * easeOut(progress));
				el.textContent = value.toLocaleString();
				if (progress < 1) {
					counterRaf.set(el, requestAnimationFrame(tick));
				} else {
					counterRaf.delete(el);
				}
			};
			counterRaf.set(el, requestAnimationFrame(tick));
		}

		function animatePanelCounters(panel: HTMLElement | null, fromZero = false) {
			if (!panel) return;
			panel.querySelectorAll<HTMLElement>('[data-impact-counter]').forEach((el) => {
				const target = parseInt(el.dataset.count || '0', 10);
				if (!Number.isFinite(target)) return;
				if (fromZero) el.textContent = '0';
				animateCounter(el, target);
			});
		}

		function activateBeach(beachId: string) {
			tabs.forEach((tab) => {
				const active = tab.dataset.beach === beachId;
				tab.classList.toggle('is-active', active);
				tab.setAttribute('aria-selected', active ? 'true' : 'false');
			});
			panels.forEach((panel) => {
				const active = panel.dataset.panel === beachId;
				panel.classList.toggle('is-active', active);
				panel.hidden = !active;
			});
			const activePanel = section.querySelector<HTMLElement>(
				`.impact-panel[data-panel="${beachId}"]`
			);
			if (sectionReady) animatePanelCounters(activePanel, true);
		}

		tabs.forEach((tab) => {
			tab.addEventListener('click', () => {
				const beachId = tab.dataset.beach;
				if (beachId) activateBeach(beachId);
			});
		});

		function runSectionAnimations() {
			if (sectionReady) return;
			sectionReady = true;
			const firstPanel = section.querySelector<HTMLElement>('.impact-panel.is-active');
			animatePanelCounters(firstPanel, true);
			section.querySelectorAll<HTMLElement>('.impact-bar-fill').forEach((bar, i) => {
				setTimeout(() => bar.classList.add('bars-animated'), 280 + i * 180);
			});
		}

		const obs = new IntersectionObserver(
			(entries) => {
				if (entries[0].isIntersecting) {
					runSectionAnimations();
					obs.disconnect();
				}
			},
			{ threshold: 0.15 }
		);
		obs.observe(section);
	})();

	// ── Programs accordion: hover on desktop, click on mobile ──
	(function () {
		const items = document.querySelectorAll<HTMLElement>('.prog-item');
		const imgs  = document.querySelectorAll<HTMLElement>('.prog-img');

		if (!items.length) return;

		function activate(index: number) {
			items.forEach((el, i) => el.classList.toggle('is-active', i === index));
			imgs.forEach((el, i)  => el.classList.toggle('is-active', i === index));
		}

		const isMobile = () => window.matchMedia('(max-width: 859px)').matches;

		items.forEach((item, i) => {
			// Desktop: mouseenter
			item.addEventListener('mouseenter', () => {
				if (!isMobile()) activate(i);
			});
			// Mobile / keyboard: click / Enter
			item.addEventListener('click', () => activate(i));
			item.addEventListener('keydown', (e: KeyboardEvent) => {
				if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); activate(i); }
			});
		});
	})();
</script>

