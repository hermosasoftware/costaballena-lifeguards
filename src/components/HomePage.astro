		}

		/* Second line — subtitle */
		.reality-sub {
			margin: 0 auto;
			max-width: 52ch;
			font-size: clamp(15px, 1.6vw, 18px);
			font-weight: 400;
			line-height: 1.7;
			color: rgba(255, 255, 255, 0.62);
		}

		.reality-accent {
			color: #e07a80;
			font-style: italic;
			font-weight: 600;
		}

		/* ── Support cards — glass + per-card color accent ──────── */

		/*
		 * Icon circle color per card — all from the blue/navy family.
		 * White SVG on colored circle = always visible, modern, friendly.
		 * The accent red stays reserved for CTA buttons only.
		 */
		.cs-support .support-card:nth-child(1) { --card-color: #2a76b5; --card-icon-bg: rgba(42, 118, 181, 0.35); }
		.cs-support .support-card:nth-child(2) { --card-color: #4d92c8; --card-icon-bg: rgba(77, 146, 200, 0.35); }
		.cs-support .support-card:nth-child(3) { --card-color: #1d5485; --card-icon-bg: rgba(29,  84, 133, 0.45); }
		.cs-support .support-card:nth-child(4) { --card-color: #3a6090; --card-icon-bg: rgba(58, 96, 144, 0.38); }

		.cs-support .support-card {
			position: relative;
			overflow: hidden;
			background: rgba(255, 255, 255, 0.05);
			border: 1px solid rgba(255, 255, 255, 0.09);
			border-radius: 24px;
			padding: 28px 22px 28px;
			box-shadow: none;
			transition: transform 0.26s cubic-bezier(0.22,1,0.36,1),
			            background 0.26s ease, border-color 0.26s ease,
			            box-shadow 0.26s ease;
		}

		/* Gradient border top — slides in from left on hover */
		.cs-support .support-card::after {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 3px;
			background: linear-gradient(
				90deg,
				var(--color-base)    0%,
				var(--color-primary) 50%,
				var(--color-accent)  100%
			);
			border-radius: 24px 24px 0 0;
			transform: scaleX(0);
			transform-origin: left center;
			transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
		}

		.cs-support .support-card:hover::after {
			transform: scaleX(1);
		}

		.cs-support .support-card:hover {
			background: rgba(255, 255, 255, 0.10);
			border-color: rgba(255, 255, 255, 0.20);
			box-shadow: 0 22px 52px rgba(0, 0, 0, 0.35);
			transform: translateY(-8px);
		}

		/* Icon: circular, always white SVG, colored circle background */
		.cs-support .support-card-icon {
			width: 52px;
			height: 52px;
			border-radius: 50%;
			background: var(--card-icon-bg);
			color: white;
			margin-bottom: 20px;
			transition: background 0.26s ease, transform 0.26s ease;
		}

		.cs-support .support-card-icon svg {
			width: 22px;
			height: 22px;
		}

		.cs-support .support-card:hover .support-card-icon {
			background: var(--card-color);
			transform: scale(1.1) rotate(-4deg);
		}

		.cs-support .support-card-title {
			color: white;
			font-size: 15px;
			font-weight: 700;
			margin: 0 0 8px;
		}

		.cs-support .support-card-desc {
			color: rgba(255, 255, 255, 0.58);
			font-size: 13.5px;
			line-height: 1.65;
			margin: 0;
		}

		/* ── Where section — light background ───────────────────── */
		.where-section {
			background: #f5f7fc;
			padding: 80px 0;
		}

		.cs-where-grid {
			align-items: center;
			gap: 56px;
		}

		/* Heading: first line regular, second bold + accent */
		.where-heading {
			font-size: clamp(26px, 3.2vw, 40px);
			font-weight: 400;
			line-height: 1.2;
			letter-spacing: -0.02em;
			color: var(--color-text);
			margin: 10px 0 18px;
		}

		.where-heading span {
			display: block;
			font-weight: 800;
			color: var(--color-base);
		}

		.where-intro {
			font-size: 14px;
			font-weight: 600;
			text-transform: uppercase;
			letter-spacing: 0.07em;
			color: var(--color-primary);
			margin: 0 0 12px;
		}

		/* Numbered list */
		.where-num-list {
			list-style: none;
			padding: 0;
			margin: 0;
			display: flex;
			flex-direction: column;
			gap: 12px;
		}

		.where-num-list li {
			display: flex;
			align-items: center;
			gap: 14px;
		}

		.where-num {
			flex-shrink: 0;
			width: 30px;
			height: 30px;
			border-radius: 50%;
			background: var(--color-base);
			color: white;
			font-size: 13px;
			font-weight: 700;
			display: flex;
			align-items: center;
			justify-content: center;
			line-height: 1;
		}

		.where-item-text {
			font-size: 15px;
			font-weight: 500;
			color: var(--color-text);
			line-height: 1.4;
		}

		/* Trust note row */
		.where-trust {
			display: flex;
			align-items: flex-start;
			gap: 10px;
			margin-top: 22px;
			padding: 14px 16px;
			background: white;
			border-left: 3px solid var(--color-primary);
			border-radius: 0 8px 8px 0;
		}

		.where-trust-icon {
			width: 18px;
			height: 18px;
			color: var(--color-primary);
			flex-shrink: 0;
			margin-top: 1px;
		}

		.where-trust-text {
			font-size: 13.5px;
			font-style: italic;
			color: var(--color-muted);
			line-height: 1.55;
			margin: 0;
		}

		/* Image column with floating badge */
		.where-img-wrap {
			position: relative;
			border-radius: 20px;
			overflow: hidden;
			box-shadow: 0 24px 56px rgba(0, 32, 91, 0.14);
		}

		.where-img {
			width: 100%;
			aspect-ratio: 4/3;
			object-fit: cover;
			display: block;
		}

		/* Floating badge — overlaps bottom-left of image */
		.where-badge {
			position: absolute;
			bottom: 16px;
			left: 16px;
			display: flex;
			align-items: center;
			gap: 10px;
			background: white;
			border-radius: 12px;
			padding: 10px 14px;
			box-shadow: 0 8px 24px rgba(0, 32, 91, 0.18);
		}

		.where-badge svg {
			width: 18px;
			height: 18px;
			color: var(--color-accent);
			flex-shrink: 0;
			stroke-width: 2.5;
		}

		.where-badge div {
			display: flex;
			flex-direction: column;
			gap: 1px;
		}

		.where-badge strong {
			font-size: 13px;
			font-weight: 700;
			color: var(--color-text);
			line-height: 1.2;
		}

		.where-badge span {
			font-size: 11px;
			color: var(--color-muted);
			line-height: 1.2;
		}

		/* ── Programs accordion ──────────────────────────────────── */
		.prog-section {
			background: #f5f7fc;
			padding: 80px 0 72px;
		}

		.prog-header {
			display: flex;
			flex-direction: column;
			gap: 12px;
			margin-bottom: 48px;
		}

		@media (min-width: 720px) {
			.prog-header {
				flex-direction: row;
				align-items: flex-end;
				justify-content: space-between;
				gap: 40px;
			}
		}

		.prog-header-text {
			flex-shrink: 0;
		}

		.prog-header .kicker {
			color: var(--color-primary) !important;
			border-color: rgba(42, 118, 181, 0.28) !important;
		}

		.prog-title {
			font-size: clamp(32px, 4vw, 52px);
			font-weight: 800;
			color: var(--color-base);
			letter-spacing: -0.025em;
			margin: 8px 0 0;
		}

		.prog-header-sub {
			font-size: 15px;
			line-height: 1.65;
			color: rgba(0, 32, 91, 0.52);
			max-width: 38ch;
			margin: 0;
			padding-bottom: 4px;
		}

		/* Two-column layout */
		.prog-layout {
			display: grid;
			grid-template-columns: 1fr;
			gap: 40px;
		}

		@media (min-width: 860px) {
			.prog-layout {
				grid-template-columns: 55% 1fr;
				gap: 56px;
				align-items: start;
			}
		}

		/* ── Accordion list ─────────── */
		.prog-list {
			display: flex;
			flex-direction: column;
		}

		.prog-divider {
			height: 1px;
			background: rgba(0, 32, 91, 0.13);
		}

		.prog-item {
			cursor: pointer;
			outline: none;
		}

		.prog-item-body {
			display: flex;
			gap: 20px;
			padding: 20px 16px 20px 20px;
			border-left: 3px solid transparent;
			border-radius: 0 12px 12px 0;
			margin-left: -3px;
			transition:
				padding 0.35s cubic-bezier(0.22, 1, 0.36, 1),
				border-color 0.3s ease,
				background 0.3s ease;
		}

		.prog-item.is-active .prog-item-body {
			padding: 26px 16px 26px 20px;
			border-left-color: var(--color-primary);
			background: rgba(42, 118, 181, 0.06);
		}

		.prog-meta {
			padding-top: 6px;
			flex-shrink: 0;
		}

		.prog-num {
			width: 30px;
			height: 30px;
			border-radius: 50%;
			border: 1.5px solid rgba(0, 32, 91, 0.2);
			background: transparent;
			display: flex;
			align-items: center;
			justify-content: center;
			font-size: 10.5px;
			font-weight: 800;
			letter-spacing: 0.04em;
			color: rgba(0, 32, 91, 0.4);
			font-variant-numeric: tabular-nums;
			flex-shrink: 0;
			transition:
				background 0.3s ease,
				border-color 0.3s ease,
				color 0.3s ease;
		}

		.prog-item.is-active .prog-num {
			background: var(--color-primary);
			border-color: var(--color-primary);
			color: white;
		}

		.prog-item:hover:not(.is-active) .prog-num {
			border-color: rgba(0, 32, 91, 0.45);
			color: rgba(0, 32, 91, 0.65);
		}

		.prog-content {
			flex: 1;
		}

		.prog-name {
			font-size: clamp(22px, 2.8vw, 36px);
			font-weight: 700;
			letter-spacing: -0.02em;
			line-height: 1.15;
			color: rgba(0, 32, 91, 0.42);
			margin: 0;
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 12px;
			transition: color 0.3s ease;
		}

		.prog-item:hover .prog-name {
			color: rgba(0, 32, 91, 0.72);
		}

		.prog-item.is-active .prog-name {
			color: var(--color-base);
		}

		.prog-arrow {
			font-size: 0.65em;
			opacity: 0;
			transform: translateX(-10px);
			transition: opacity 0.3s ease, transform 0.3s ease;
			flex-shrink: 0;
			color: var(--color-primary);
		}

		.prog-item.is-active .prog-arrow {
			opacity: 1;
			transform: translateX(0);
		}

		/* Expandable description */
		.prog-desc {
			max-height: 0;
			overflow: hidden;
			transition: max-height 0.45s cubic-bezier(0.22, 1, 0.36, 1);
		}

		.prog-item.is-active .prog-desc {
			max-height: 160px;
		}

		.prog-desc p {
			margin: 12px 0 0;
			font-size: 15px;
			line-height: 1.7;
			color: rgba(0, 32, 91, 0.6);
		}

		/* CTA below list */
		.prog-cta {
			display: flex;
			align-items: center;
			gap: 20px;
			margin-top: 36px;
			flex-wrap: wrap;
		}

		.prog-cta-note {
			font-size: 13px;
			color: rgba(0, 32, 91, 0.45);
			margin: 0;
		}

		/* CTA button on light bg: outline dark */
		.prog-cta .btn-outline {
			border-color: rgba(0, 32, 91, 0.35);
			color: var(--color-base);
		}

		.prog-cta .btn-outline:hover {
			background: var(--color-base);
			border-color: var(--color-base);
			color: white;
		}

		/* ── Image preview ──────────── */
		.prog-preview {
			display: none;
		}

		@media (min-width: 860px) {
			.prog-preview {
				display: block;
				position: sticky;
				top: 90px;
			}
		}

		.prog-img-stack {
			position: relative;
			border-radius: 20px;
			overflow: hidden;
			aspect-ratio: 3/4;
			background: rgba(0, 32, 91, 0.06);
			box-shadow: 0 16px 48px rgba(0, 32, 91, 0.14);
		}

		.prog-img {
			position: absolute;
			inset: 0;
			width: 100%;
			height: 100%;
			object-fit: cover;
			opacity: 0;
			transition: opacity 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			            transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
			transform: scale(1.04);
		}

		.prog-img.is-active {
			opacity: 1;
			transform: scale(1);
		}

		/* ── Impact section (2026) — story + dashboard grid ───── */
		.impact-section {
			padding: 80px 0 72px;
		}

		.impact-header {
			text-align: center;
			margin-bottom: 48px;
		}

		.impact-title {
			color: white;
			margin: 8px 0 10px;
		}

		.impact-subtitle {
			color: rgba(255, 255, 255, 0.62);
			font-size: 16px;
			margin: 0 auto 10px;
			max-width: 42ch;
			font-style: italic;
		}

		.impact-period {
			display: inline-block;
			font-size: 11.5px;
			font-weight: 600;
			letter-spacing: 0.08em;
			text-transform: uppercase;
			color: rgba(255, 255, 255, 0.3);
			border: 1px solid rgba(255, 255, 255, 0.14);
			border-radius: 999px;
			padding: 4px 14px;
		}

		.impact-body {
			display: grid;
			grid-template-columns: 1fr;
			gap: 36px;
			align-items: start;
		}

		@media (min-width: 960px) {
			.impact-body {
				grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
				gap: 48px;
			}
		}

		/* Reference-style thank-you column */
		.impact-story {
			padding: 28px 24px;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(255, 255, 255, 0.09);
			border-radius: 20px;
		}

		.impact-update-kicker {
			margin: 0 0 14px;
			font-size: 11px;
			font-weight: 700;
			letter-spacing: 0.12em;
			text-transform: uppercase;
			color: #4ade80;
		}

		.impact-thanks-title {
			margin: 0 0 16px;
			font-size: clamp(22px, 3vw, 30px);
			font-weight: 800;
			line-height: 1.25;
			color: white;
			letter-spacing: -0.02em;
		}

		.impact-thanks-p {
			margin: 0 0 14px;
			font-size: 15px;
			line-height: 1.75;
			color: rgba(255, 255, 255, 0.68);
		}

		.impact-thanks-p:last-of-type {
			margin-bottom: 22px;
		}

		.impact-funded-list {
			list-style: none;
			margin: 0;
			padding: 0;
			display: flex;
			flex-direction: column;
			gap: 10px;
		}

		.impact-funded-list li {
			display: flex;
			align-items: center;
			gap: 10px;
			padding: 10px 14px;
			border-radius: 10px;
			background: rgba(34, 197, 94, 0.1);
			border: 1px solid rgba(34, 197, 94, 0.28);
			font-size: 13px;
			font-weight: 600;
			color: rgba(255, 255, 255, 0.82);
		}

		.impact-funded-dot {
			width: 8px;
			height: 8px;
			border-radius: 50%;
			background: #4ade80;
			box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.25);
			flex-shrink: 0;
		}

		/* Data dashboard */
		.impact-dashboard {
			display: flex;
			flex-direction: column;
			gap: 16px;
			min-width: 0;
		}

		.impact-tabs-hint {
			margin: 0;
			font-size: 13px;
			font-weight: 600;
			color: rgba(255, 255, 255, 0.5);
		}

		.impact-segment {
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: 4px;
			padding: 5px;
			background: rgba(0, 0, 0, 0.22);
			border: 1px solid rgba(255, 255, 255, 0.14);
			border-radius: 14px;
			box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
		}

		.impact-segment-btn {
			padding: 13px 16px;
			border: none;
			border-radius: 10px;
			background: transparent;
			color: rgba(255, 255, 255, 0.55);
			font-size: 14px;
			font-weight: 800;
			cursor: pointer;
			transition:
				background 0.2s ease,
				color 0.2s ease,
				box-shadow 0.2s ease,
				transform 0.15s ease;
		}

		.impact-segment-btn:hover {
			color: rgba(255, 255, 255, 0.9);
			background: rgba(255, 255, 255, 0.06);
		}

		.impact-segment-btn.is-active {
			background: linear-gradient(180deg, var(--color-primary-500) 0%, var(--color-primary-600) 100%);
			color: white;
			box-shadow:
				0 4px 14px rgba(42, 118, 181, 0.45),
				0 0 0 1px rgba(255, 255, 255, 0.12);
		}

		.impact-segment-btn:focus-visible {
			outline: 2px solid var(--color-primary-400);
			outline-offset: 2px;
		}

		.impact-panel {
			display: none;
			flex-direction: column;
			gap: 20px;
		}

		.impact-panel.is-active {
			display: flex;
			animation: impact-panel-in 0.35s ease;
		}

		@keyframes impact-panel-in {
			from {
				opacity: 0;
				transform: translateY(6px);
			}
			to {
				opacity: 1;
				transform: translateY(0);
			}
		}

		.impact-panel-period {
			margin: 0;
			font-size: 12px;
			font-weight: 600;
			letter-spacing: 0.06em;
			text-transform: uppercase;
			color: rgba(255, 255, 255, 0.42);
		}

		.impact-prevention {
			display: grid;
			grid-template-columns: 1fr;
			gap: 28px;
			background: rgba(255, 255, 255, 0.04);
			border: 1px solid rgba(255, 255, 255, 0.09);
			border-radius: 20px;
			padding: 28px 24px;
		}

		@media (min-width: 640px) {
			.impact-prevention {
				grid-template-columns: auto 1fr;
				gap: 40px;
				align-items: center;
			}
		}

		.impact-metric-icon {
			width: 36px;
			height: 36px;
			border-radius: 50%;
			background: rgba(255, 255, 255, 0.1);
			color: rgba(255, 255, 255, 0.75);
			display: flex;
			align-items: center;
			justify-content: center;
			margin-bottom: 12px;
		}

		.impact-metric-icon svg {
			width: 18px;
			height: 18px;
		}

		.impact-metric-icon--hero {
			background: rgba(34, 197, 94, 0.16);
			color: #4ade80;
		}

		.impact-big-num {
			font-size: clamp(52px, 8vw, 88px);
			font-weight: 900;
			color: white;
			line-height: 1;
			letter-spacing: -0.04em;
		}

		.impact-big-label {
			font-size: 13px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.1em;
			color: var(--color-primary-400);
			margin-top: 6px;
		}

		.impact-prev-note {
			color: rgba(255, 255, 255, 0.5);
			font-size: 13.5px;
			line-height: 1.65;
			margin: 14px 0 0;
			max-width: 32ch;
			font-style: italic;
		}

		.impact-prev-bars {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}

		.impact-bars-title {
			margin: 0 0 4px;
			font-size: 11px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.09em;
			color: rgba(255, 255, 255, 0.45);
		}

		.impact-bar-header {
			display: flex;
			justify-content: space-between;
			align-items: baseline;
			margin-bottom: 8px;
			font-size: 13.5px;
		}

		.impact-bar-header span {
			color: rgba(255, 255, 255, 0.58);
		}

		.impact-bar-header strong {
			color: white;
			font-size: 15px;
			font-weight: 700;
		}

		.impact-bar-track {
			height: 8px;
			background: rgba(255, 255, 255, 0.1);
			border-radius: 999px;
			overflow: hidden;
		}

		.impact-bar-fill {
			height: 100%;
			width: 0;
