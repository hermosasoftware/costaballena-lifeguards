	<style>
		/* ── Hero copy ───────────────────────────────────────── */
		.hero-copy {
			max-width: 600px;
			display: flex;
			flex-direction: column;
		}

		.hero-btn-sponsor {
			padding: 14px 30px;
			font-size: 15px;
			font-weight: 800;
			letter-spacing: 0.01em;
			box-shadow: 0 4px 24px rgba(237, 67, 76, 0.45);
		}

		.hero-btn-volunteer {
			padding: 14px 26px;
			font-size: 15px;
			font-weight: 700;
			border-color: rgba(255, 255, 255, 0.52);
		}

		.hero-btn-volunteer:hover {
			background: rgba(255, 255, 255, 0.1);
			border-color: rgba(255, 255, 255, 0.85);
		}

		/* ── Hero stats — Mobile First ───────────────────────── */
		/* Base: 3-col grid (avoids flex overflow on narrow screens) */
		.hero-stats {
			display: grid;
			grid-template-columns: repeat(3, 1fr);
			gap: 8px 0;
			margin-top: 28px;
			padding-top: 20px;
			border-top: 1px solid rgba(255, 255, 255, 0.18);
		}

		.hero-stat {
